<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PotatoVN.MusicBox.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
        </Style>
        <!--
            The big accent play/pause button — the visual anchor of the bar.
            56x56 accent circle, white glyph on top.
        -->
        <Style x:Key="MainPlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        RowSpacing="0"
        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="4" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Row 0: top accent progress ribbon ============ -->
        <Grid
            x:Name="PositionRibbon"
            Grid.Row="0"
            Height="4"
            Background="{ThemeResource ControlFillColorTertiaryBrush}"
            SizeChanged="PositionRibbon_SizeChanged">
            <Rectangle
                x:Name="PositionFill"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Width="0"
                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>

        <!-- ============ Row 1: main transport row ============ -->
        <Grid
            Grid.Row="1"
            Padding="22,10,22,12"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="280" MaxWidth="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ──── Left: cover + song meta ──── -->
            <Grid Grid.Column="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="72"
                    Height="72"
                    CornerRadius="14"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon
                            x:Name="CoverPlaceholder"
                            FontSize="26"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;" />
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="未在播放"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="选择一首曲目开始"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="AlbumText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- ──── Center: transport + inline timeline ──── -->
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="ShuffleButton"
                        Click="ShuffleButton_Click"
                        Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="随机播放">
                        <FontIcon x:Name="ShuffleIcon" FontSize="14" Glyph="&#xE8B1;" />
                    </Button>

                    <Button
                        x:Name="PreviousButton"
                        Click="PreviousButton_Click"
                        Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="上一首">
                        <FontIcon FontSize="16" Glyph="&#xE892;" />
                    </Button>

                    <Button
                        x:Name="PlayPauseButton"
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource MainPlayButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="20" Glyph="&#xE768;" />
                    </Button>

                    <Button
                        x:Name="NextButton"
                        Click="NextButton_Click"
                        Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="下一首">
                        <FontIcon FontSize="16" Glyph="&#xE893;" />
                    </Button>

                    <Button
                        x:Name="RepeatButton"
                        Click="RepeatButton_Click"
                        Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="循环模式">
                        <FontIcon x:Name="RepeatIcon" FontSize="14" Glyph="&#xE8EE;" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="PositionText"
                        Grid.Column="0"
                        MinWidth="40"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        Text="0:00"
                        TextAlignment="Right" />

                    <Slider
                        x:Name="PositionSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="PositionSlider_ValueChanged" />

                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        MinWidth="40"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        Text="0:00" />
                </Grid>
            </Grid>

            <!-- ──── Right: queue + volume ──── -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="QueueButton"
                    Click="QueueButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="播放队列">
                    <FontIcon FontSize="15" Glyph="&#xE8FD;" />
                </Button>

                <Button
                    x:Name="MuteButton"
                    Click="MuteButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="静音">
                    <FontIcon x:Name="VolumeIcon" FontSize="15" Glyph="&#xE767;" />
                </Button>

                <Slider
                    x:Name="VolumeSlider"
                    Width="96"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="True"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="0.01"
                    ValueChanged="VolumeSlider_ValueChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
