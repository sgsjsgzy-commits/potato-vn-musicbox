<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PotatoVN.MusicBox.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="PrimaryTransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Padding="18,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Now playing: artwork + metadata -->
        <Grid Grid.Column="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="52"
                Height="52"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <FontIcon
                        x:Name="CoverPlaceholder"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8D6;" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                MinWidth="140"
                MaxWidth="260"
                VerticalAlignment="Center"
                Spacing="1">
                <TextBlock
                    x:Name="TitleText"
                    FontWeight="SemiBold"
                    Text="未在播放"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="11"
                    Text="选择一首曲目开始"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="AlbumText"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Transport + progress -->
        <Grid Grid.Column="1" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="ShuffleButton"
                    Click="ShuffleButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="随机播放">
                    <FontIcon x:Name="ShuffleIcon" FontSize="13" Glyph="&#xE8B1;" />
                </Button>

                <Button
                    x:Name="PreviousButton"
                    Click="PreviousButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="上一首">
                    <FontIcon FontSize="15" Glyph="&#xE892;" />
                </Button>

                <Button
                    x:Name="PlayPauseButton"
                    Click="PlayPauseButton_Click"
                    Style="{StaticResource PrimaryTransportButtonStyle}"
                    ToolTipService.ToolTip="播放 / 暂停">
                    <FontIcon x:Name="PlayPauseIcon" FontSize="16" Glyph="&#xE768;" />
                </Button>

                <Button
                    x:Name="NextButton"
                    Click="NextButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="下一首">
                    <FontIcon FontSize="15" Glyph="&#xE893;" />
                </Button>

                <Button
                    x:Name="RepeatButton"
                    Click="RepeatButton_Click"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTipService.ToolTip="循环模式">
                    <FontIcon x:Name="RepeatIcon" FontSize="13" Glyph="&#xE8EE;" />
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PositionText"
                    Grid.Column="0"
                    MinWidth="36"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="11"
                    Text="0:00"
                    TextAlignment="Right" />

                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="PositionSlider_ValueChanged" />

                <TextBlock
                    x:Name="DurationText"
                    Grid.Column="2"
                    MinWidth="36"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="11"
                    Text="0:00" />
            </Grid>
        </Grid>

        <!-- Extra controls -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="0">
            <Button
                x:Name="QueueButton"
                Click="QueueButton_Click"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="播放队列">
                <FontIcon FontSize="13" Glyph="&#xE8FD;" />
            </Button>

            <Button
                x:Name="MuteButton"
                Click="MuteButton_Click"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="静音">
                <FontIcon x:Name="VolumeIcon" FontSize="13" Glyph="&#xE767;" />
            </Button>
        </StackPanel>

        <Slider
            x:Name="VolumeSlider"
            Grid.Column="3"
            Width="88"
            VerticalAlignment="Center"
            IsThumbToolTipEnabled="True"
            Maximum="1"
            Minimum="0"
            StepFrequency="0.01"
            ValueChanged="VolumeSlider_ValueChanged" />
    </Grid>
</UserControl>
